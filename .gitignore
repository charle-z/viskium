# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.tmp-*/
.hypothesis/
.mypy_cache/
.ruff_cache/
.uv-cache/

# Environments
.venv/
.wheel-venv/
.extras-wheel-venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/

# Coverage and test reports
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Local configuration and secrets
.env
.env.*
!.env.example

# Viskium runtime-owned data
.viskium/
data/
artifacts/runs/
benchmarks/results/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.dmp

# Private engineering plans retained only in the local working copy
docs/plans/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Keep the reproducibility lock under version control.
!uv.lock
